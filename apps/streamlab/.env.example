# ============================================================
# StreamLab — Environment Configuration (modo nativo).
# ============================================================
# Para arranque Docker, la configuración común vive en
# infra/compose/.env.docker (y el WEB_PORT/MONGO_DB específico
# de cada app se hardcodea en docker-compose.yml).
# ============================================================

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=streamlab

# --- Data Lake ---
# Vacio = default Quasar: <repo>/infra/data/streamlab/{raw,silver,gold,checkpoints}
# raw/ es el buzon donde el emisor deja micro-lotes y del que Spark lee.
DATA_LAKE_PATH=

# --- Spark ---
SPARK_MASTER=local[*]

# --- Web ---
WEB_HOST=0.0.0.0
WEB_PORT=8003
WEB_DEBUG=true

# --- General ---
ENV=local
LOG_LEVEL=INFO

# --- Parametros del laboratorio ---
# Umbral de riesgo termico (C) del centro de control.
STREAMLAB_TEMP_ALERTA=75

# --- Modo laboratorio (StreamLab) ---
# Bloques desbloqueados (resueltos). Lo no listado se sirve como scaffold.
# Bloques: windows | late | state
# Atajo:   all
LAB_STREAMLAB=
